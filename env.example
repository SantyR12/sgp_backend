# ══════════════════════════════════════════════════════
# SGP Backend — Variables de entorno
# Copiar este archivo como .env y completar los valores
# NUNCA subir .env al repositorio Git
# ══════════════════════════════════════════════════════

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sgp_db
DB_USER=postgres
DB_PASSWORD=admin

# JWT
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_seguro_minimo_64_caracteres
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=otro_secreto_diferente_para_el_refresh_token_tambien_largo
JWT_REFRESH_EXPIRES_IN=7d

# Email (para verificación y OTP)
# Para desarrollo usar Mailtrap: https://mailtrap.io (gratis)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=tu_usuario_mailtrap
MAIL_PASS=tu_password_mailtrap
MAIL_FROM=noreply@sgp.com

# URL del frontend (para links de verificación)
FRONTEND_URL=http://localhost:3000

# OTP — tiempo de expiración en minutos
OTP_EXPIRES_MINUTES=5
